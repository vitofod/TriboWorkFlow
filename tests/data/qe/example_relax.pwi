&CONTROL
  calculation = 'relax'
  title = 'A_title'
  prefix = 'A_prefix'
  restart_mode = 'from_scratch'
  nstep = 150
  outdir = 'path/to/output_dir'
  max_seconds = 84600
  tstress = .false.
  pseudo_dir = 'path/to/PSEUDO'
  disk_io = 'low'
  etot_conv_thr = 1.0D-4
  forc_conv_thr = 1.0D-3
/
&SYSTEM
  ibrav = 0
  nat = 6
  ntyp = 1
  ecutwfc = 45.0
  ecutrho = 360.0
  occupations = 'smearing'
  degauss = 0.01
  smearing = 'mv'
  nspin = 2
  starting_magnetization(1) = 0.5
  vdw_corr = 'none'
/
&ELECTRONS
  electron_maxstep = 200
  conv_thr = 1e-06
  mixing_mode = 'local-TF'
  mixing_beta = 0.3
  diagonalization = 'david'
/

&IONS
  ion_dynamics = 'bfgs'
/

